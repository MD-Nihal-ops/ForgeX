# Copy to .env and fill in values as needed. Do not commit .env.

FORGEX_DATA_DIR=./data/projects
FORGEX_ENABLE_CAD=0
FORGEX_USE_DATABASE=false
DATABASE_URL=
POSTGRES_PASSWORD=

# Optional LLM. Leave unset to run fully offline.
FORGEX_LLM_API_KEY=
FORGEX_LLM_BASE_URL=
FORGEX_LLM_MODEL=
FORGEX_LLM_TIMEOUT_S=30
